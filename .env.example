# NOTA DE SEGURIDAD: Jamás suba el archivo .env real con credenciales a Git.

# --- Backend (apps/api) ---
PORT=3000
NODE_ENV=development
DATABASE_URL="file:./dev.db"

# CORS y orígenes permitidos
FRONTEND_URL=http://localhost:5173

# Parámetros preliminares de autenticación (fases posteriores)
JWT_SECRET=cambiar_este_secreto_en_entorno_real_grupo_prisma_2026
JWT_EXPIRATION=900s
REFRESH_TOKEN_EXPIRATION=7d

# --- Frontend (apps/web) ---
VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_TITLE="Prisma Business Dashboard"

